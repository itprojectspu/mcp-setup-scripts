# ==============================================================================
# MCP Setup Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file or tokens to source control!
# ==============================================================================

# GitHub Personal Access Token (PAT)
# Required permissions: repo (full control), read:org (organization access)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere1234567890

# Google Cloud Project Configuration
# Set the target GCP project ID (e.g., parfumia-512320)
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Account Email
GCP_ACCOUNT=your-user@your-domain.com
